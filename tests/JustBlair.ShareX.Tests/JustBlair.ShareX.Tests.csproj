<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The plugin is Windows-only; the tests that touch ShareX itself run only there. -->
        <NoWarn>$(NoWarn);CA1416</NoWarn>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Underscored test names, like the Macro Deck repository's own test projects. -->
        <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MacroDeck.Plugin.Testing" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NUnit" />
        <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
        <PackageReference Include="NUnit3TestAdapter" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\JustBlair.ShareX\JustBlair.ShareX.csproj" />
    </ItemGroup>

</Project>
